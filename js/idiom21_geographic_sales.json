{
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    },
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": "bold"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 355,
  "title": {
    "text": "How Has Funko's Regional Sales Share Changed?",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_verified_geography_sales_2021_2025.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_sales_usd_thousands)/1000",
      "as": "SalesMillions"
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "aggregate": "sum",
      "field": "SalesMillions",
      "type": "quantitative",
      "title": "Share of annual net sales",
      "stack": "normalize",
      "axis": {
        "format": ".0%"
      },
      "scale": {
        "domain": [
          0,
          1
        ]
      }
    },
    "color": {
      "field": "region",
      "type": "nominal",
      "title": "Region",
      "scale": {
        "domain": [
          "United States",
          "Europe",
          "Other International"
        ],
        "range": [
          "#5C4FA3",
          "#C05792",
          "#1F8C83"
        ]
      },
      "legend": {
        "orient": "bottom"
      }
    },
    "order": {
      "field": "region",
      "sort": "ascending"
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "region",
        "title": "Region"
      },
      {
        "aggregate": "sum",
        "field": "SalesMillions",
        "type": "quantitative",
        "format": ",.3f",
        "title": "Regional sales (USD million)"
      }
    ]
  }
}
