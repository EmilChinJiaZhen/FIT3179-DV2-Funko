{
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    },
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": "bold"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 355,
  "title": {
    "text": "How Has Funko's Regional Sales Share Changed?",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_verified_geography_sales_2021_2025.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_sales_usd_thousands)/1000",
      "as": "SalesMillions"
    }
  ],
  "params": [
    {
      "name": "selectedRegion",
      "select": {
        "type": "point",
        "fields": [
          "region"
        ],
        "on": "click",
        "clear": "dblclick",
        "toggle": true
      }
    },
    {
      "name": "regionStoryYear",
      "value": 2025
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "SalesMillions",
          "type": "quantitative",
          "title": "Share of annual net sales",
          "stack": "normalize",
          "axis": {
            "format": ".0%"
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": "Region",
          "scale": {
            "domain": [
              "United States",
              "Europe",
              "Other International"
            ],
            "range": [
              "#5C4FA3",
              "#C05792",
              "#1F8C83"
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },
        "order": {
          "field": "region",
          "sort": "ascending"
        },
        "opacity": {
          "condition": {
            "param": "selectedRegion",
            "value": 1
          },
          "value": 0.2
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "SalesMillions",
              "as": "RegionSales"
            }
          ],
          "groupby": [
            "year",
            "region"
          ]
        },
        {
          "stack": "RegionSales",
          "groupby": [
            "year"
          ],
          "sort": [
            {
              "field": "region",
              "order": "ascending"
            }
          ],
          "offset": "normalize",
          "as": [
            "y0",
            "y1"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1)/2",
          "as": "SegmentMid"
        },
        {
          "filter": "datum.region === 'Europe' && toNumber(datum.year) === regionStoryYear"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontWeight": "bold",
        "fontSize": 12,
        "color": "#C62828",
        "stroke": "#F4F0E8",
        "strokeWidth": 3,
        "strokeJoin": "round",
        "align": "center",
        "baseline": "middle",
        "dx": 0,
        "dy": 0
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "SegmentMid",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "text": {
          "condition": [
            {
              "test": "toNumber(datum.year) === 2021",
              "value": "Europe 20.9%"
            },
            {
              "test": "toNumber(datum.year) === 2025",
              "value": "Europe 31.8%"
            }
          ],
          "value": ""
        }
      }
    }
  ]
}
