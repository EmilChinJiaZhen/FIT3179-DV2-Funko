{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 430,
  "title": {
    "text": "Where Is Funko Pop Search Interest Highest?",
    "subtitle": [
      "Google Trends relative search interest by country",
      "13 Sep 2025 – 13 Sep 2026 · 100 = highest relative interest in this comparison"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E6E6",
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_search_interest_country.csv"
            },
            "key": "TopoCountry",
            "fields": [
              "Country",
              "Interest"
            ]
          }
        },
        {
          "filter": "isValid(datum.Interest)"
        }
      ],
      "mark": {
        "type": "geoshape"
      },
      "encoding": {
        "color": {
          "field": "Interest",
          "type": "quantitative",
          "title": "Relative search interest",
          "scale": {
            "scheme": "viridis",
            "domain": [
              1,
              100
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 300,
            "gradientThickness": 14,
            "titleFont": "Arial",
            "titleFontSize": 12,
            "labelFont": "Arial",
            "labelFontSize": 11,
            "values": [
              1,
              25,
              50,
              75,
              100
            ]
          }
        },
        "stroke": {
          "condition": {
            "test": "datum.properties.NAME == 'Malaysia'",
            "value": "#111111"
          },
          "value": "white"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.properties.NAME == 'Malaysia'",
            "value": 1.8
          },
          "value": 0.6
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Interest",
            "type": "quantitative",
            "title": "Relative search interest"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    }
  }
}
