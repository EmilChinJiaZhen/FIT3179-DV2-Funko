{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 440,
  "title": {
    "text": "Do Exclusive Funko Products Cost More?",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
    "format": {
      "type": "csv",
      "parse": {
        "price": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.product_type) && datum.product_type != ''"
    },
    {
      "filter": "isValid(datum.price) && datum.price > 0"
    },
    {
      "calculate": "indexof(lower(toString(datum.tags)), 'exclusive') >= 0 ? 'Exclusive-tagged' : 'No exclusive tag'",
      "as": "Exclusive_Status"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "price",
          "as": "Average_Price"
        },
        {
          "op": "median",
          "field": "price",
          "as": "Median_Price"
        },
        {
          "op": "min",
          "field": "price",
          "as": "Minimum_Price"
        },
        {
          "op": "max",
          "field": "price",
          "as": "Maximum_Price"
        },
        {
          "op": "count",
          "field": "uid",
          "as": "Product_Count"
        }
      ],
      "groupby": [
        "product_type",
        "Exclusive_Status"
      ]
    },
    {
      "calculate": "datum.Exclusive_Status == 'Exclusive-tagged' ? datum.Average_Price : null",
      "as": "Exclusive_Avg_Part"
    },
    {
      "calculate": "datum.Exclusive_Status == 'No exclusive tag' ? datum.Average_Price : null",
      "as": "No_Exclusive_Avg_Part"
    },
    {
      "calculate": "datum.Exclusive_Status == 'Exclusive-tagged' ? datum.Product_Count : 0",
      "as": "Exclusive_Count_Part"
    },
    {
      "calculate": "datum.Exclusive_Status == 'No exclusive tag' ? datum.Product_Count : 0",
      "as": "No_Exclusive_Count_Part"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "Exclusive_Avg_Part",
          "as": "Exclusive_Average"
        },
        {
          "op": "max",
          "field": "No_Exclusive_Avg_Part",
          "as": "No_Exclusive_Average"
        },
        {
          "op": "max",
          "field": "Exclusive_Count_Part",
          "as": "Exclusive_Count"
        },
        {
          "op": "max",
          "field": "No_Exclusive_Count_Part",
          "as": "No_Exclusive_Count"
        },
        {
          "op": "sum",
          "field": "Product_Count",
          "as": "Total_Products"
        }
      ],
      "groupby": [
        "product_type"
      ]
    },
    {
      "filter": "datum.Exclusive_Count > 0 && datum.No_Exclusive_Count > 0"
    },
    {
      "calculate": "datum.Exclusive_Average - datum.No_Exclusive_Average",
      "as": "Price_Difference"
    },
    {
      "calculate": "datum.Price_Difference / datum.No_Exclusive_Average",
      "as": "Price_Difference_Percent"
    },
    {
      "calculate": "datum.Product_Count / datum.Total_Products",
      "as": "Group_Share"
    },
    {
      "calculate": "(datum.Exclusive_Average + datum.No_Exclusive_Average) / 2",
      "as": "Mid_Price"
    },
    {
      "calculate": "abs(datum.Price_Difference) < 0.005 ? 'Same average' : (datum.Price_Difference > 0 ? '+$' : '-$') + format(abs(datum.Price_Difference), '.2f')",
      "as": "Difference_Label"
    },
    {
      "calculate": "(datum.Price_Difference >= 0 ? '+' : '') + format(datum.Price_Difference_Percent, '.1%')",
      "as": "Difference_Percent_Label"
    },
    {
      "calculate": "'$' + format(datum.Minimum_Price, '.2f') + ' – $' + format(datum.Maximum_Price, '.2f')",
      "as": "Price_Range"
    },
    {
      "calculate": "format(datum.Group_Share, '.1%')",
      "as": "Group_Share_Label"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "ProductType_Rank"
        }
      ],
      "sort": [
        {
          "field": "Total_Products",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.ProductType_Rank <= 6"
    },
    {
      "filter": "chosenPriceType === 'All' || datum.product_type === chosenPriceType"
    }
  ],
  "encoding": {
    "y": {
      "field": "product_type",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "Total_Products",
        "order": "descending"
      },
      "axis": {
        "labelFont": "Inter",
        "labelFontSize": 13,
        "labelLimit": 180
      }
    },
    "opacity": {
      "condition": {
        "test": "linkedProductType === '' || datum.product_type === linkedProductType",
        "value": 1
      },
      "value": 0.16
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "datum.Exclusive_Status == 'Exclusive-tagged'"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 5,
        "color": "#CFCFCF"
      },
      "encoding": {
        "x": {
          "field": "No_Exclusive_Average",
          "type": "quantitative",
          "title": "Average listed price (USD)",
          "axis": {
            "format": "$.0f",
            "grid": true,
            "labelFont": "Inter",
            "labelFontSize": 11,
            "titleFont": "Inter",
            "titleFontSize": 13,
            "titleFontWeight": "normal"
          }
        },
        "x2": {
          "field": "Exclusive_Average"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 245,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Average_Price",
          "type": "quantitative",
          "title": "Average listed price (USD)"
        },
        "color": {
          "field": "Exclusive_Status",
          "type": "nominal",
          "title": "Product status",
          "scale": {
            "domain": [
              "No exclusive tag",
              "Exclusive-tagged"
            ],
            "range": [
              "#B8B8B8",
              "#C9A227"
            ]
          },
          "legend": {
            "titleFont": "Inter",
            "labelFont": "Inter",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "padding": 12
          }
        }
      },
      "transform": [
        {
          "filter": "abs(datum.Price_Difference) >= 0.005"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 340,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Average_Price",
          "type": "quantitative",
          "title": "Average listed price (USD)"
        },
        "color": {
          "field": "Exclusive_Status",
          "type": "nominal",
          "title": "Product status",
          "scale": {
            "domain": [
              "No exclusive tag",
              "Exclusive-tagged"
            ],
            "range": [
              "#B8B8B8",
              "#C9A227"
            ]
          },
          "legend": {
            "titleFont": "Inter",
            "labelFont": "Inter",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "padding": 12
          }
        }
      },
      "transform": [
        {
          "filter": "abs(datum.Price_Difference) < 0.005 && datum.Exclusive_Status == 'No exclusive tag'"
        }
      ]
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 105,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "Average_Price",
          "type": "quantitative",
          "title": "Average listed price (USD)"
        },
        "color": {
          "field": "Exclusive_Status",
          "type": "nominal",
          "title": "Product status",
          "scale": {
            "domain": [
              "No exclusive tag",
              "Exclusive-tagged"
            ],
            "range": [
              "#B8B8B8",
              "#C9A227"
            ]
          },
          "legend": {
            "titleFont": "Inter",
            "labelFont": "Inter",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 210,
            "padding": 12
          }
        }
      },
      "transform": [
        {
          "filter": "abs(datum.Price_Difference) < 0.005 && datum.Exclusive_Status == 'Exclusive-tagged'"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.Exclusive_Status == 'Exclusive-tagged'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -13,
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {
          "field": "Mid_Price",
          "type": "quantitative"
        },
        "text": {
          "field": "Difference_Label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    },
    "title": {
      "font": "Inter",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "background": "transparent"
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "params": [
    {
      "name": "chosenPriceType",
      "value": "All",
      "bind": {
        "input": "select",
        "name": "Product type: ",
        "options": [
          "All",
          "Pop!",
          "Apparel",
          "Board Games",
          "Keychains",
          "Plush",
          "Pop! Jumbo",
          "Action Figures"
        ]
      }
    },
    {
      "name": "linkedProductType",
      "value": ""
    }
  ]
}
