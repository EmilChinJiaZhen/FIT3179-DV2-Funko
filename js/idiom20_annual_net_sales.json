{
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    },
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "fontWeight": "bold"
    }
  },
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Funko Annual Net Sales, 2021–2025",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_verified_annual_sales_2021_2025.csv"
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_sales_usd_thousands) / 1000",
      "as": "SalesMillions"
    }
  ],
  "vconcat": [
    {
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "SalesMillions",
          "type": "quantitative",
          "title": "Net sales (USD million)",
          "scale": {
            "zero": false
          }
        }
      },
      "width": "container",
      "height": 350,
      "layer": [
        {
          "mark": {
            "type": "line",
            "strokeWidth": 3,
            "color": "#3a9c68"
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 115,
            "color": "#4E79A7"
          }
        },
        {
          "mark": {
            "type": "point",
            "shape": "circle",
            "filled": false,
            "stroke": "#172238",
            "strokeWidth": 2.5,
            "size": 380
          },
          "encoding": {
            "opacity": {
              "condition": {
                "test": "toNumber(datum.year) === storyYear",
                "value": 1
              },
              "value": 0
            }
          }
        }
      ],
      "transform": [
        {
          "filter": {
            "param": "salesBrush"
          }
        }
      ]
    },
    {
      "width": "container",
      "height": 65,
      "mark": {
        "type": "line",
        "color": "#3a9c68",
        "strokeWidth": 2,
        "point": {
          "size": 45
        }
      },
      "params": [
        {
          "name": "salesBrush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "SalesMillions",
          "type": "quantitative",
          "title": null,
          "scale": {
            "zero": false
          },
          "axis": {
            "tickCount": 3
          }
        }
      }
    }
  ],
  "spacing": 12,
  "params": [
    {
      "name": "storyYear",
      "value": 0
    }
  ]
}
