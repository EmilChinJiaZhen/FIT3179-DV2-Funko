{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 560,
  "height": 470,
  "padding": {
    "top": 15,
    "left": 10,
    "right": 10,
    "bottom": 25
  },
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "title": {
    "text": "How Are Funko's Top Licenses Connected to Product Types?",
    "subtitle": [
      "Connections between the six leading licenses and six most common product types",
      "Ribbon width represents the number of products, 2019–2022"
    ],
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Inter",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "signals": [
    {
      "name": "cx",
      "update": "width / 2"
    },
    {
      "name": "cy",
      "update": "260"
    },
    {
      "name": "radius",
      "update": "150"
    },
    {
      "name": "innerR",
      "update": "radius - 10"
    },
    {
      "name": "outerR",
      "update": "radius + 5"
    },
    {
      "name": "gap",
      "update": "2 * PI / 180"
    },
    {
      "name": "leftStart",
      "update": "110 * PI / 180"
    },
    {
      "name": "leftSpan",
      "update": "140 * PI / 180"
    },
    {
      "name": "rightStart",
      "update": "-70 * PI / 180"
    },
    {
      "name": "rightSpan",
      "update": "140 * PI / 180"
    }
  ],
  "data": [
    {
      "name": "base",
      "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.license) && datum.license != '' && isValid(datum.product_type) && datum.product_type != '' && isValid(datum.published_at)"
        },
        {
          "type": "formula",
          "expr": "toDate(datum.published_at)",
          "as": "ReleaseDate"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.ReleaseDate)"
        },
        {
          "type": "formula",
          "expr": "year(datum.ReleaseDate)",
          "as": "ReleaseYear"
        },
        {
          "type": "filter",
          "expr": "datum.ReleaseYear >= 2019 && datum.ReleaseYear <= 2022"
        }
      ]
    },
    {
      "name": "license_totals",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "license"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Total_Products"
          ]
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "Rank"
          ],
          "sort": {
            "field": [
              "Total_Products",
              "license"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        },
        {
          "type": "filter",
          "expr": "datum.Rank <= 6"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "Total_Products"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "SideTotal"
          ]
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "Total_Products"
          ],
          "as": [
            "CumTotal"
          ],
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "leftStart + ((datum.CumTotal - datum.Total_Products) / datum.SideTotal) * (leftSpan - gap * 5) + gap * (datum.Rank - 1)",
          "as": "StartAngle"
        },
        {
          "type": "formula",
          "expr": "leftStart + (datum.CumTotal / datum.SideTotal) * (leftSpan - gap * 5) + gap * (datum.Rank - 1)",
          "as": "EndAngle"
        },
        {
          "type": "formula",
          "expr": "(datum.StartAngle + datum.EndAngle) / 2",
          "as": "MidAngle"
        },
        {
          "type": "formula",
          "expr": "cx + (outerR + 13) * sin(datum.MidAngle)",
          "as": "LabelX"
        },
        {
          "type": "formula",
          "expr": "cy - (outerR + 13) * cos(datum.MidAngle)",
          "as": "LabelY"
        }
      ]
    },
    {
      "name": "type_totals",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "product_type"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Total_Products"
          ]
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "Rank"
          ],
          "sort": {
            "field": [
              "Total_Products",
              "product_type"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        },
        {
          "type": "filter",
          "expr": "datum.Rank <= 6"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "Total_Products"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "SideTotal"
          ]
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "Total_Products"
          ],
          "as": [
            "CumTotal"
          ],
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "rightStart + ((datum.CumTotal - datum.Total_Products) / datum.SideTotal) * (rightSpan - gap * 5) + gap * (datum.Rank - 1)",
          "as": "StartAngle"
        },
        {
          "type": "formula",
          "expr": "rightStart + (datum.CumTotal / datum.SideTotal) * (rightSpan - gap * 5) + gap * (datum.Rank - 1)",
          "as": "EndAngle"
        },
        {
          "type": "formula",
          "expr": "(datum.StartAngle + datum.EndAngle) / 2",
          "as": "MidAngle"
        },
        {
          "type": "formula",
          "expr": "cx + (outerR + 13) * sin(datum.MidAngle)",
          "as": "LabelX"
        },
        {
          "type": "formula",
          "expr": "cy - (outerR + 13) * cos(datum.MidAngle)",
          "as": "LabelY"
        }
      ]
    },
    {
      "name": "links",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "license",
            "product_type"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Connection_Count"
          ]
        },
        {
          "type": "lookup",
          "from": "license_totals",
          "key": "license",
          "fields": [
            "license"
          ],
          "values": [
            "Rank",
            "StartAngle",
            "EndAngle",
            "Total_Products"
          ],
          "as": [
            "License_Rank",
            "LicenseStart",
            "LicenseEnd",
            "License_Total"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.License_Rank)"
        },
        {
          "type": "lookup",
          "from": "type_totals",
          "key": "product_type",
          "fields": [
            "product_type"
          ],
          "values": [
            "Rank",
            "StartAngle",
            "EndAngle",
            "Total_Products"
          ],
          "as": [
            "Type_Rank",
            "TypeStart",
            "TypeEnd",
            "Type_Total"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.Type_Rank)"
        },
        {
          "type": "window",
          "groupby": [
            "license"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "Connection_Count"
          ],
          "as": [
            "SourceCum"
          ],
          "sort": {
            "field": "Type_Rank",
            "order": "ascending"
          }
        },
        {
          "type": "window",
          "groupby": [
            "product_type"
          ],
          "ops": [
            "sum"
          ],
          "fields": [
            "Connection_Count"
          ],
          "as": [
            "TargetCum"
          ],
          "sort": {
            "field": "License_Rank",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "datum.LicenseStart + ((datum.SourceCum - datum.Connection_Count) / datum.License_Total) * (datum.LicenseEnd - datum.LicenseStart)",
          "as": "SourceA0"
        },
        {
          "type": "formula",
          "expr": "datum.LicenseStart + (datum.SourceCum / datum.License_Total) * (datum.LicenseEnd - datum.LicenseStart)",
          "as": "SourceA1"
        },
        {
          "type": "formula",
          "expr": "datum.TypeStart + ((datum.TargetCum - datum.Connection_Count) / datum.Type_Total) * (datum.TypeEnd - datum.TypeStart)",
          "as": "TargetA0"
        },
        {
          "type": "formula",
          "expr": "datum.TypeStart + (datum.TargetCum / datum.Type_Total) * (datum.TypeEnd - datum.TypeStart)",
          "as": "TargetA1"
        },
        {
          "type": "formula",
          "expr": "cx + innerR * sin(datum.SourceA0)",
          "as": "sx0"
        },
        {
          "type": "formula",
          "expr": "cy - innerR * cos(datum.SourceA0)",
          "as": "sy0"
        },
        {
          "type": "formula",
          "expr": "cx + innerR * sin(datum.SourceA1)",
          "as": "sx1"
        },
        {
          "type": "formula",
          "expr": "cy - innerR * cos(datum.SourceA1)",
          "as": "sy1"
        },
        {
          "type": "formula",
          "expr": "cx + innerR * sin(datum.TargetA0)",
          "as": "tx0"
        },
        {
          "type": "formula",
          "expr": "cy - innerR * cos(datum.TargetA0)",
          "as": "ty0"
        },
        {
          "type": "formula",
          "expr": "cx + innerR * sin(datum.TargetA1)",
          "as": "tx1"
        },
        {
          "type": "formula",
          "expr": "cy - innerR * cos(datum.TargetA1)",
          "as": "ty1"
        },
        {
          "type": "formula",
          "expr": "'M' + datum.sx0 + ',' + datum.sy0 + ' A' + innerR + ',' + innerR + ' 0 0 1 ' + datum.sx1 + ',' + datum.sy1 + ' Q' + cx + ',' + cy + ' ' + datum.tx1 + ',' + datum.ty1 + ' A' + innerR + ',' + innerR + ' 0 0 0 ' + datum.tx0 + ',' + datum.ty0 + ' Q' + cx + ',' + cy + ' ' + datum.sx0 + ',' + datum.sy0 + ' Z'",
          "as": "RibbonPath"
        },
        {
          "type": "formula",
          "expr": "datum.Connection_Count / datum.License_Total",
          "as": "License_Share"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "path": {
            "field": "RibbonPath"
          },
          "fill": {
            "value": "#CFCFCF"
          },
          "fillOpacity": {
            "value": 0.58
          },
          "stroke": {
            "value": null
          },
          "tooltip": {
            "signal": "{'License': datum.license, 'Product type': datum.product_type, 'Products': datum.Connection_Count, 'Share of license': format(datum.License_Share, '.1%')}"
          }
        },
        "update": {
          "fill": {
            "value": "#CFCFCF"
          },
          "fillOpacity": {
            "value": 0.58
          }
        },
        "hover": {
          "fill": {
            "value": "#9FBAD8"
          },
          "fillOpacity": {
            "value": 0.88
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "license_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "field": "StartAngle"
          },
          "endAngle": {
            "field": "EndAngle"
          },
          "innerRadius": {
            "signal": "innerR"
          },
          "outerRadius": {
            "signal": "outerR"
          },
          "fill": {
            "value": "#149AD6"
          },
          "stroke": {
            "value": null
          },
          "tooltip": {
            "signal": "{'License': datum.license, 'Products': datum.Total_Products}"
          }
        }
      }
    },
    {
      "type": "arc",
      "from": {
        "data": "type_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "cx"
          },
          "y": {
            "signal": "cy"
          },
          "startAngle": {
            "field": "StartAngle"
          },
          "endAngle": {
            "field": "EndAngle"
          },
          "innerRadius": {
            "signal": "innerR"
          },
          "outerRadius": {
            "signal": "outerR"
          },
          "fill": {
            "value": "#149AD6"
          },
          "stroke": {
            "value": null
          },
          "tooltip": {
            "signal": "{'Product type': datum.product_type, 'Products': datum.Total_Products}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "license_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "LabelX"
          },
          "y": {
            "field": "LabelY"
          },
          "text": {
            "field": "license"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#222222"
          },
          "limit": {
            "value": 125
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "type_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "LabelX"
          },
          "y": {
            "field": "LabelY"
          },
          "text": {
            "field": "product_type"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#222222"
          },
          "limit": {
            "value": 125
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 100
          },
          "y": {
            "value": 40
          },
          "text": {
            "value": "Top licenses"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#555555"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "value": 75
          },
          "x2": {
            "value": 175
          },
          "y": {
            "value": 49
          },
          "stroke": {
            "value": "#D4D0C8"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width - 100"
          },
          "y": {
            "value": 40
          },
          "text": {
            "value": "Top product types"
          },
          "align": {
            "value": "right"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#555555"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "signal": "width - 175"
          },
          "x2": {
            "signal": "width - 75"
          },
          "y": {
            "value": 49
          },
          "stroke": {
            "value": "#D4D0C8"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height - 8"
          },
          "text": {
            "value": "Wider ribbons represent more products"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#666666"
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "fill": null,
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter",
      "fontSize": 20,
      "fontWeight": "bold",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal"
    }
  }
}
