{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 620,
  "height": 470,
  "padding": {
    "top": 20,
    "left": 15,
    "right": 15,
    "bottom": 30
  },
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "background": "transparent",
  "title": {
    "text": "How Are Funko's Top Licenses Connected to Product Types?",
    "subtitle": [
      "Connections between the six leading licenses and six most common product types",
      "Ribbon thickness represents the number of products, 2019–2022"
    ],
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Inter",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "signals": [
    {
      "name": "leftX",
      "update": "155"
    },
    {
      "name": "rightX",
      "update": "width - 155"
    },
    {
      "name": "topY",
      "update": "85"
    },
    {
      "name": "bottomY",
      "update": "height - 55"
    },
    {
      "name": "nodeGap",
      "update": "8"
    }
  ],
  "data": [
    {
      "name": "base",
      "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.license) && datum.license != '' && isValid(datum.product_type) && datum.product_type != '' && isValid(datum.published_at)"
        },
        {
          "type": "formula",
          "expr": "toDate(datum.published_at)",
          "as": "ReleaseDate"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.ReleaseDate)"
        },
        {
          "type": "formula",
          "expr": "year(datum.ReleaseDate)",
          "as": "ReleaseYear"
        },
        {
          "type": "filter",
          "expr": "datum.ReleaseYear >= 2019 && datum.ReleaseYear <= 2022"
        }
      ]
    },
    {
      "name": "license_totals",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "license"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Total_Products"
          ]
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "Rank"
          ],
          "sort": {
            "field": [
              "Total_Products",
              "license"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        },
        {
          "type": "filter",
          "expr": "datum.Rank <= 6"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "Total_Products"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "SideTotal"
          ]
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "Total_Products"
          ],
          "as": [
            "CumTotal"
          ],
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "topY + ((datum.CumTotal - datum.Total_Products) / datum.SideTotal) * (bottomY - topY - nodeGap * 5) + nodeGap * (datum.Rank - 1)",
          "as": "y0"
        },
        {
          "type": "formula",
          "expr": "topY + (datum.CumTotal / datum.SideTotal) * (bottomY - topY - nodeGap * 5) + nodeGap * (datum.Rank - 1)",
          "as": "y1"
        },
        {
          "type": "formula",
          "expr": "(datum.y0 + datum.y1) / 2",
          "as": "yc"
        }
      ]
    },
    {
      "name": "type_totals",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "product_type"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Total_Products"
          ]
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "Rank"
          ],
          "sort": {
            "field": [
              "Total_Products",
              "product_type"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        },
        {
          "type": "filter",
          "expr": "datum.Rank <= 6"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "Total_Products"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "SideTotal"
          ]
        },
        {
          "type": "window",
          "ops": [
            "sum"
          ],
          "fields": [
            "Total_Products"
          ],
          "as": [
            "CumTotal"
          ],
          "sort": {
            "field": "Rank",
            "order": "ascending"
          }
        },
        {
          "type": "formula",
          "expr": "topY + ((datum.CumTotal - datum.Total_Products) / datum.SideTotal) * (bottomY - topY - nodeGap * 5) + nodeGap * (datum.Rank - 1)",
          "as": "y0"
        },
        {
          "type": "formula",
          "expr": "topY + (datum.CumTotal / datum.SideTotal) * (bottomY - topY - nodeGap * 5) + nodeGap * (datum.Rank - 1)",
          "as": "y1"
        },
        {
          "type": "formula",
          "expr": "(datum.y0 + datum.y1) / 2",
          "as": "yc"
        }
      ]
    },
    {
      "name": "links",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "license",
            "product_type"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "Connection_Count"
          ]
        },
        {
          "type": "lookup",
          "from": "license_totals",
          "key": "license",
          "fields": [
            "license"
          ],
          "values": [
            "Rank",
            "y0",
            "y1",
            "yc",
            "Total_Products"
          ],
          "as": [
            "License_Rank",
            "LicenseY0",
            "LicenseY1",
            "LicenseYC",
            "License_Total"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.License_Rank)"
        },
        {
          "type": "lookup",
          "from": "type_totals",
          "key": "product_type",
          "fields": [
            "product_type"
          ],
          "values": [
            "Rank",
            "y0",
            "y1",
            "yc",
            "Total_Products"
          ],
          "as": [
            "Type_Rank",
            "TypeY0",
            "TypeY1",
            "TypeYC",
            "Type_Total"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.Type_Rank)"
        },
        {
          "type": "formula",
          "expr": "datum.Connection_Count / datum.License_Total",
          "as": "License_Share"
        },
        {
          "type": "formula",
          "expr": "'M' + leftX + ',' + datum.LicenseYC + ' C' + (leftX + 120) + ',' + datum.LicenseYC + ' ' + (rightX - 120) + ',' + datum.TypeYC + ' ' + rightX + ',' + datum.TypeYC",
          "as": "Path"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "licenseColor",
      "type": "ordinal",
      "domain": {
        "data": "license_totals",
        "field": "license"
      },
      "range": [
        "#4E79A7",
        "#76B7B2",
        "#F2CF5B",
        "#F28E2B",
        "#E15759",
        "#59A14F"
      ]
    },
    {
      "name": "linkWidth",
      "type": "sqrt",
      "domain": {
        "data": "links",
        "field": "Connection_Count"
      },
      "range": [
        2,
        18
      ],
      "zero": true
    }
  ],
  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX"
          },
          "y": {
            "value": 35
          },
          "text": {
            "value": "Top licenses"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#555555"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "rightX"
          },
          "y": {
            "value": 35
          },
          "text": {
            "value": "Top product types"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#555555"
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX - 65"
          },
          "x2": {
            "signal": "leftX + 65"
          },
          "y": {
            "value": 45
          },
          "stroke": {
            "value": "#D4D0C8"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "signal": "rightX - 65"
          },
          "x2": {
            "signal": "rightX + 65"
          },
          "y": {
            "value": 45
          },
          "stroke": {
            "value": "#D4D0C8"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "links"
      },
      "encode": {
        "enter": {
          "path": {
            "field": "Path"
          },
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#C8C8C8"
          },
          "strokeWidth": {
            "scale": "linkWidth",
            "field": "Connection_Count"
          },
          "strokeOpacity": {
            "value": 0.46
          },
          "strokeCap": {
            "value": "round"
          },
          "tooltip": {
            "signal": "{'License': datum.license, 'Product type': datum.product_type, 'Products': datum.Connection_Count, 'Share of license': format(datum.License_Share, '.1%')}"
          }
        },
        "update": {
          "stroke": {
            "value": "#C8C8C8"
          },
          "strokeOpacity": {
            "value": 0.46
          },
          "strokeWidth": {
            "scale": "linkWidth",
            "field": "Connection_Count"
          }
        },
        "hover": {
          "stroke": {
            "scale": "licenseColor",
            "field": "license"
          },
          "strokeOpacity": {
            "value": 0.9
          },
          "strokeWidth": {
            "signal": "scale('linkWidth', datum.Connection_Count) + 2"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "license_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX - 7"
          },
          "x2": {
            "signal": "leftX + 7"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "scale": "licenseColor",
            "field": "license"
          },
          "cornerRadius": {
            "value": 4
          },
          "tooltip": {
            "signal": "{'License': datum.license, 'Products': datum.Total_Products}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "type_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightX - 7"
          },
          "x2": {
            "signal": "rightX + 7"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#4F4F4F"
          },
          "cornerRadius": {
            "value": 4
          },
          "tooltip": {
            "signal": "{'Product type': datum.product_type, 'Products': datum.Total_Products}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "license_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "leftX - 16"
          },
          "y": {
            "field": "yc"
          },
          "text": {
            "field": "license"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#222222"
          },
          "limit": {
            "value": 135
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "type_totals"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "rightX + 16"
          },
          "y": {
            "field": "yc"
          },
          "text": {
            "field": "product_type"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#222222"
          },
          "limit": {
            "value": 135
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height - 8"
          },
          "text": {
            "value": "Thicker ribbons represent more products"
          },
          "align": {
            "value": "center"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#666666"
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "fill": null,
      "stroke": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter",
      "fontSize": 20,
      "fontWeight": "bold",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal"
    }
  }
}
