{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 780,
  "height": 450,
  "padding": {
    "left": 72,
    "right": 126,
    "top": 46,
    "bottom": 49
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "title": {
    "text": "Funko Brand Sales Performance Relative to 2021",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "offset": 16
  },
  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/main/data/funko_verified_brand_sales_2021_2025.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "toNumber(datum.year)",
          "as": "yr"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.net_sales_usd_thousands)",
          "as": "sales"
        }
      ]
    },
    {
      "name": "baseline",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.yr === 2021"
        }
      ]
    },
    {
      "name": "year_summary",
      "source": "raw",
      "transform": [
        {
          "type": "pivot",
          "field": "reported_brand_category",
          "value": "sales",
          "groupby": [
            "yr"
          ]
        },
        {
          "type": "formula",
          "expr": "datum['Core Collectible'] / 1000",
          "as": "coreM"
        },
        {
          "type": "formula",
          "expr": "datum['Loungefly'] / 1000",
          "as": "loungeflyM"
        },
        {
          "type": "formula",
          "expr": "datum['Other'] / 1000",
          "as": "otherM"
        }
      ]
    },
    {
      "name": "points",
      "source": "raw",
      "transform": [
        {
          "type": "lookup",
          "from": "baseline",
          "key": "reported_brand_category",
          "fields": [
            "reported_brand_category"
          ],
          "values": [
            "sales"
          ],
          "as": [
            "baseSales"
          ]
        },
        {
          "type": "formula",
          "expr": "100 * datum.sales / datum.baseSales",
          "as": "index"
        },
        {
          "type": "formula",
          "expr": "datum.sales / 1000",
          "as": "millions"
        },
        {
          "type": "formula",
          "expr": "(datum.index - 100)",
          "as": "changePct"
        },
        {
          "type": "lookup",
          "from": "year_summary",
          "key": "yr",
          "fields": [
            "yr"
          ],
          "values": [
            "coreM",
            "loungeflyM",
            "otherM"
          ],
          "as": [
            "coreM",
            "loungeflyM",
            "otherM"
          ]
        }
      ]
    },
    {
      "name": "points_post2021",
      "source": "points",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.yr > 2021"
        }
      ]
    },
    {
      "name": "ends",
      "source": "points",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.yr === 2025"
        }
      ]
    },
    {
      "name": "base_summary",
      "source": "year_summary",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.yr === 2021"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "point",
      "domain": [
        2021,
        2022,
        2023,
        2024,
        2025
      ],
      "range": "width",
      "padding": 0
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "points",
        "field": "index"
      },
      "nice": true,
      "zero": false,
      "range": "height"
    },
    {
      "name": "brandColor",
      "type": "ordinal",
      "domain": [
        "Core Collectible",
        "Loungefly",
        "Other"
      ],
      "range": [
        "#9EA4AC",
        "#3A9C68",
        "#C7C0CB"
      ]
    }
  ],
  "marks": [
    {
      "type": "rule",
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "x2": {
            "signal": "width"
          },
          "y": {
            "scale": "y",
            "value": 100
          },
          "stroke": {
            "value": "#6b7280"
          },
          "strokeOpacity": {
            "value": 0.4
          },
          "strokeDash": {
            "value": [
              5,
              5
            ]
          }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "brandSeries",
          "data": "points",
          "groupby": [
            "reported_brand_category"
          ]
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {
            "data": "brandSeries"
          },
          "sort": {
            "field": "yr"
          },
          "encode": {
            "enter": {
              "x": {
                "scale": "x",
                "field": "yr"
              },
              "y": {
                "scale": "y",
                "field": "index"
              },
              "stroke": {
                "scale": "brandColor",
                "field": "reported_brand_category"
              },
              "strokeWidth": {
                "value": 3.5
              },
              "strokeCap": {
                "value": "round"
              },
              "interpolate": {
                "value": "linear"
              }
            }
          }
        }
      ]
    },
    {
      "type": "symbol",
      "from": {
        "data": "points_post2021"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "yr"
          },
          "y": {
            "scale": "y",
            "field": "index"
          },
          "size": {
            "value": 130
          },
          "fill": {
            "scale": "brandColor",
            "field": "reported_brand_category"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{ 'Year': datum.yr, 'Selected brand': datum.reported_brand_category, 'Selected brand sales (USD M)': format(datum.millions, ',.1f'), 'Sales index': format(datum.index, '.1f'), 'Change vs 2021': (datum.changePct >= 0 ? '+' : '') + format(datum.changePct, '.1f') + '%', 'Core Collectible sales (USD M)': format(datum.coreM, ',.1f'), 'Loungefly sales (USD M)': format(datum.loungeflyM, ',.1f'), 'Other sales (USD M)': format(datum.otherM, ',.1f') }"
          }
        },
        "hover": {
          "size": {
            "value": 240
          },
          "strokeWidth": {
            "value": 2.6
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "base_summary"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "value": 2021
          },
          "y": {
            "scale": "y",
            "value": 100
          },
          "size": {
            "value": 280
          },
          "fill": {
            "value": "#252b35"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Year': '2021 baseline', 'Sales index': '100 for all three brands', 'Core Collectible sales (USD M)': format(datum.coreM, ',.1f'), 'Loungefly sales (USD M)': format(datum.loungeflyM, ',.1f'), 'Other sales (USD M)': format(datum.otherM, ',.1f')}"
          }
        },
        "hover": {
          "size": {
            "value": 340
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ends"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "scale('x',datum.yr) + 16"
          },
          "y": {
            "signal": "scale('y',datum.index) + (datum.reported_brand_category === 'Loungefly' ? -19 : datum.reported_brand_category === 'Core Collectible' ? 14 : -11)"
          },
          "text": {
            "field": "reported_brand_category"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "scale": "brandColor",
            "field": "reported_brand_category"
          },
          "baseline": {
            "value": "bottom"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ends"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "scale('x',datum.yr) + 16"
          },
          "y": {
            "signal": "scale('y',datum.index) + (datum.reported_brand_category === 'Loungefly' ? -15 : datum.reported_brand_category === 'Core Collectible' ? 18 : -7)"
          },
          "text": {
            "signal": "(datum.changePct >= 0 ? '+' : '') + format(datum.changePct,'.1f') + '% vs 2021'"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#686868"
          },
          "baseline": {
            "value": "top"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "values": [
        2021,
        2022,
        2023,
        2024,
        2025
      ],
      "labelFlush": false,
      "labelOverlap": false,
      "title": "Year",
      "titleFont": "Inter",
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "grid": false,
      "format": "d"
    },
    {
      "orient": "left",
      "scale": "y",
      "title": "Sales relative to 2021 (2021 = 100)",
      "titleFont": "Inter",
      "titleFontSize": 13,
      "titleFontWeight": "normal",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "grid": true,
      "gridColor": "#d1d5db",
      "gridOpacity": 0.55
    }
  ]
}
