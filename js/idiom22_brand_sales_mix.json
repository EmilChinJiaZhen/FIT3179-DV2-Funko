{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 350,
  "background": "transparent",
  "title": {
    "text": "How Have Funko's Brand Sales Changed Since 2021?",
    "font": "Inter",
    "fontSize": 20
  },
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/main/data/funko_verified_brand_sales_2021_2025.csv"
  },
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 100
    },
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year",
      "sort": "ascending",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "IndexedSales",
      "type": "quantitative",
      "title": "Sales index (2021 = 100)",
      "scale": {
        "zero": false
      }
    },
    "color": {
      "field": "reported_brand_category",
      "type": "nominal",
      "title": "Brand category",
      "scale": {
        "domain": [
          "Core Collectible",
          "Loungefly",
          "Other"
        ],
        "range": [
          "#3a9c68",
          "#4E79A7",
          "#B07AA1"
        ]
      },
      "legend": {
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "reported_brand_category",
        "title": "Brand group"
      },
      {
        "field": "IndexedSales",
        "type": "quantitative",
        "title": "Sales index (2021 = 100)",
        "format": ".1f"
      },
      {
        "field": "SalesMillions",
        "type": "quantitative",
        "title": "Net sales (USD million)",
        "format": ",.1f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter",
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "normal"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.net_sales_usd_thousands)",
      "as": "SalesThousands"
    },
    {
      "calculate": "toNumber(datum.year) == 2021 ? datum.SalesThousands : 0",
      "as": "BaseYearSales"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "BaseYearSales",
          "as": "Sales2021"
        }
      ],
      "groupby": [
        "reported_brand_category"
      ]
    },
    {
      "calculate": "datum.Sales2021 > 0 ? 100 * datum.SalesThousands / datum.Sales2021 : null",
      "as": "IndexedSales"
    },
    {
      "calculate": "datum.SalesThousands / 1000",
      "as": "SalesMillions"
    }
  ]
}
