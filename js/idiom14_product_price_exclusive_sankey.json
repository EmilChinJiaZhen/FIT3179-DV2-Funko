{
  "$schema": "https://vega.github.io/schema/vega/v6.json",

  "width": 980,
  "height": 580,

  "padding": {
    "top": 10,
    "left": 10,
    "right": 10,
    "bottom": 30
  },

  "autosize": {
    "type": "pad",
    "resize": true
  },

  "title": {
    "text": "How Do Funko Product Types Connect to Price and Exclusivity?",
    "subtitle": [
      "Product type → listed price band → exclusive-tagged status, 2019–2022",
      "Flow width represents the number of products"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 24,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },

  "signals": [
    {
      "name": "flowTop",
      "value": 65
    },
    {
      "name": "flowHeight",
      "value": 440
    },
    {
      "name": "nodeWidth",
      "value": 22
    },
    {
      "name": "x1",
      "value": 170
    },
    {
      "name": "x2",
      "value": 490
    },
    {
      "name": "x3",
      "value": 810
    }
  ],

  "data": [
    {
      "name": "base",

      "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",

      "format": {
        "type": "csv"
      },

      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.uid) && isValid(datum.published_at) && isValid(datum.product_type) && datum.product_type != '' && isValid(datum.price) && datum.price != ''"
        },

        {
          "type": "formula",
          "expr": "toDate(datum.published_at)",
          "as": "ReleaseDate"
        },

        {
          "type": "filter",
          "expr": "isValid(datum.ReleaseDate)"
        },

        {
          "type": "formula",
          "expr": "year(datum.ReleaseDate)",
          "as": "ReleaseYear"
        },

        {
          "type": "filter",
          "expr": "datum.ReleaseYear >= 2019 && datum.ReleaseYear <= 2022"
        },

        {
          "type": "formula",
          "expr": "trim(toString(datum.product_type))",
          "as": "ProductTypeClean"
        },

        {
          "type": "formula",
          "expr": "toNumber(datum.price)",
          "as": "PriceValue"
        },

        {
          "type": "filter",
          "expr": "isValid(datum.PriceValue) && datum.PriceValue > 0"
        },

        {
          "type": "formula",
          "expr": "indexof(lower(toString(datum.tags)), 'exclusive') >= 0 ? 'Exclusive-tagged' : 'No exclusive tag'",
          "as": "ExclusiveStatus"
        },

        {
          "type": "window",
          "sort": {
            "field": [
              "PriceValue",
              "uid"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "PriceOrder"
          ]
        },

        {
          "type": "joinaggregate",
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "TotalPriceProducts"
          ]
        },

        {
          "type": "formula",
          "expr": "(datum.PriceOrder - 1) / datum.TotalPriceProducts",
          "as": "PricePosition"
        },

        {
          "type": "formula",
          "expr": "datum.PricePosition < (1/3) ? 'Lower price' : datum.PricePosition < (2/3) ? 'Middle price' : 'Higher price'",
          "as": "PriceBand"
        },

        {
          "type": "formula",
          "expr": "datum.PriceBand == 'Lower price' ? 1 : datum.PriceBand == 'Middle price' ? 2 : 3",
          "as": "PriceBandOrder"
        },

        {
          "type": "formula",
          "expr": "datum.ExclusiveStatus == 'Exclusive-tagged' ? 1 : 2",
          "as": "StatusOrder"
        }
      ]
    },

    {
      "name": "product_rank",

      "source": "base",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ProductTypeClean"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "ProductTotal"
          ]
        },

        {
          "type": "window",
          "sort": {
            "field": [
              "ProductTotal",
              "ProductTypeClean"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "ProductRank"
          ]
        }
      ]
    },

    {
      "name": "classified",

      "source": "base",

      "transform": [
        {
          "type": "lookup",
          "from": "product_rank",
          "key": "ProductTypeClean",
          "fields": [
            "ProductTypeClean"
          ],
          "values": [
            "ProductRank"
          ],
          "as": [
            "ProductRank"
          ]
        },

        {
          "type": "formula",
          "expr": "datum.ProductRank <= 6 ? datum.ProductTypeClean : 'Other product types'",
          "as": "ProductGroup"
        },

        {
          "type": "formula",
          "expr": "datum.ProductRank <= 6 ? datum.ProductRank : 99",
          "as": "ProductOrder"
        }
      ]
    },

    {
      "name": "nodes1",

      "source": "classified",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ProductGroup",
            "ProductOrder"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "NodeCount"
          ]
        },

        {
          "type": "stack",
          "field": "NodeCount",
          "sort": {
            "field": "ProductOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "p0",
            "p1"
          ]
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p0 * flowHeight",
          "as": "Y0"
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p1 * flowHeight",
          "as": "Y1"
        },

        {
          "type": "formula",
          "expr": "(datum.Y0 + datum.Y1) / 2",
          "as": "NodeY"
        }
      ]
    },

    {
      "name": "nodes2",

      "source": "classified",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "PriceBand",
            "PriceBandOrder"
          ],
          "ops": [
            "count",
            "min",
            "max"
          ],
          "fields": [
            "uid",
            "PriceValue",
            "PriceValue"
          ],
          "as": [
            "NodeCount",
            "MinPrice",
            "MaxPrice"
          ]
        },

        {
          "type": "stack",
          "field": "NodeCount",
          "sort": {
            "field": "PriceBandOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "p0",
            "p1"
          ]
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p0 * flowHeight",
          "as": "Y0"
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p1 * flowHeight",
          "as": "Y1"
        },

        {
          "type": "formula",
          "expr": "(datum.Y0 + datum.Y1) / 2",
          "as": "NodeY"
        },

        {
          "type": "formula",
          "expr": "datum.PriceBand + ' ($' + format(datum.MinPrice, '.2f') + '–$' + format(datum.MaxPrice, '.2f') + ')'",
          "as": "PriceBandLabel"
        }
      ]
    },

    {
      "name": "nodes3",

      "source": "classified",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ExclusiveStatus",
            "StatusOrder"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "NodeCount"
          ]
        },

        {
          "type": "stack",
          "field": "NodeCount",
          "sort": {
            "field": "StatusOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "p0",
            "p1"
          ]
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p0 * flowHeight",
          "as": "Y0"
        },

        {
          "type": "formula",
          "expr": "flowTop + datum.p1 * flowHeight",
          "as": "Y1"
        },

        {
          "type": "formula",
          "expr": "(datum.Y0 + datum.Y1) / 2",
          "as": "NodeY"
        }
      ]
    },

    {
      "name": "links12",

      "source": "classified",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ProductGroup",
            "ProductOrder",
            "PriceBand",
            "PriceBandOrder"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "FlowCount"
          ]
        },

        {
          "type": "lookup",
          "from": "nodes1",
          "key": "ProductGroup",
          "fields": [
            "ProductGroup"
          ],
          "values": [
            "Y0",
            "Y1",
            "NodeCount"
          ],
          "as": [
            "SourceY0",
            "SourceY1",
            "SourceNodeCount"
          ]
        },

        {
          "type": "lookup",
          "from": "nodes2",
          "key": "PriceBand",
          "fields": [
            "PriceBand"
          ],
          "values": [
            "Y0",
            "Y1",
            "NodeCount",
            "MinPrice",
            "MaxPrice"
          ],
          "as": [
            "TargetY0",
            "TargetY1",
            "TargetNodeCount",
            "MinPrice",
            "MaxPrice"
          ]
        },

        {
          "type": "stack",
          "groupby": [
            "ProductGroup"
          ],
          "field": "FlowCount",
          "sort": {
            "field": "PriceBandOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "s0",
            "s1"
          ]
        },

        {
          "type": "stack",
          "groupby": [
            "PriceBand"
          ],
          "field": "FlowCount",
          "sort": {
            "field": "ProductOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "t0",
            "t1"
          ]
        },

        {
          "type": "formula",
          "expr": "datum.SourceY0 + ((datum.s0 + datum.s1) / 2) * (datum.SourceY1 - datum.SourceY0)",
          "as": "SourceY"
        },

        {
          "type": "formula",
          "expr": "datum.TargetY0 + ((datum.t0 + datum.t1) / 2) * (datum.TargetY1 - datum.TargetY0)",
          "as": "TargetY"
        },

        {
          "type": "formula",
          "expr": "max(2, (datum.FlowCount / datum.SourceNodeCount) * (datum.SourceY1 - datum.SourceY0) * 0.92)",
          "as": "LinkWidth"
        },

        {
          "type": "formula",
          "expr": "datum.FlowCount / datum.SourceNodeCount",
          "as": "SourceShare"
        },

        {
          "type": "formula",
          "expr": "datum.FlowCount / datum.TargetNodeCount",
          "as": "TargetShare"
        },

        {
          "type": "formula",
          "expr": "'M' + (x1 + nodeWidth) + ',' + datum.SourceY + ' C' + ((x1 + nodeWidth + x2) / 2) + ',' + datum.SourceY + ' ' + ((x1 + nodeWidth + x2) / 2) + ',' + datum.TargetY + ' ' + x2 + ',' + datum.TargetY",
          "as": "Path"
        }
      ]
    },

    {
      "name": "links23",

      "source": "classified",

      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "PriceBand",
            "PriceBandOrder",
            "ExclusiveStatus",
            "StatusOrder"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "FlowCount"
          ]
        },

        {
          "type": "lookup",
          "from": "nodes2",
          "key": "PriceBand",
          "fields": [
            "PriceBand"
          ],
          "values": [
            "Y0",
            "Y1",
            "NodeCount",
            "MinPrice",
            "MaxPrice"
          ],
          "as": [
            "SourceY0",
            "SourceY1",
            "SourceNodeCount",
            "MinPrice",
            "MaxPrice"
          ]
        },

        {
          "type": "lookup",
          "from": "nodes3",
          "key": "ExclusiveStatus",
          "fields": [
            "ExclusiveStatus"
          ],
          "values": [
            "Y0",
            "Y1",
            "NodeCount"
          ],
          "as": [
            "TargetY0",
            "TargetY1",
            "TargetNodeCount"
          ]
        },

        {
          "type": "stack",
          "groupby": [
            "PriceBand"
          ],
          "field": "FlowCount",
          "sort": {
            "field": "StatusOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "s0",
            "s1"
          ]
        },

        {
          "type": "stack",
          "groupby": [
            "ExclusiveStatus"
          ],
          "field": "FlowCount",
          "sort": {
            "field": "PriceBandOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "t0",
            "t1"
          ]
        },

        {
          "type": "formula",
          "expr": "datum.SourceY0 + ((datum.s0 + datum.s1) / 2) * (datum.SourceY1 - datum.SourceY0)",
          "as": "SourceY"
        },

        {
          "type": "formula",
          "expr": "datum.TargetY0 + ((datum.t0 + datum.t1) / 2) * (datum.TargetY1 - datum.TargetY0)",
          "as": "TargetY"
        },

        {
          "type": "formula",
          "expr": "max(2, (datum.FlowCount / datum.SourceNodeCount) * (datum.SourceY1 - datum.SourceY0) * 0.92)",
          "as": "LinkWidth"
        },

        {
          "type": "formula",
          "expr": "datum.FlowCount / datum.SourceNodeCount",
          "as": "SourceShare"
        },

        {
          "type": "formula",
          "expr": "datum.FlowCount / datum.TargetNodeCount",
          "as": "TargetShare"
        },

        {
          "type": "formula",
          "expr": "'M' + (x2 + nodeWidth) + ',' + datum.SourceY + ' C' + ((x2 + nodeWidth + x3) / 2) + ',' + datum.SourceY + ' ' + ((x2 + nodeWidth + x3) / 2) + ',' + datum.TargetY + ' ' + x3 + ',' + datum.TargetY",
          "as": "Path"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "productColor",
      "type": "ordinal",
      "domain": {
        "data": "nodes1",
        "field": "ProductGroup"
      },
      "range": {
        "scheme": "tableau10"
      }
    },

    {
      "name": "priceColor",
      "type": "ordinal",
      "domain": [
        "Lower price",
        "Middle price",
        "Higher price"
      ],
      "range": [
        "#C7C7C7",
        "#858585",
        "#444444"
      ]
    },

    {
      "name": "statusColor",
      "type": "ordinal",
      "domain": [
        "Exclusive-tagged",
        "No exclusive tag"
      ],
      "range": [
        "#F28E2B",
        "#BDBDBD"
      ]
    }
  ],

  "marks": [
    {
      "type": "path",

      "from": {
        "data": "links12"
      },

      "encode": {
        "enter": {
          "path": {
            "field": "Path"
          },

          "fill": {
            "value": null
          },

          "stroke": {
            "scale": "productColor",
            "field": "ProductGroup"
          },

          "strokeWidth": {
            "field": "LinkWidth"
          },

          "strokeOpacity": {
            "value": 0.4
          },

          "strokeCap": {
            "value": "butt"
          },

          "tooltip": {
            "signal": "{'Product type': datum.ProductGroup, 'Price band': datum.PriceBand, 'Price range': '$' + format(datum.MinPrice, '.2f') + ' – $' + format(datum.MaxPrice, '.2f'), 'Products': datum.FlowCount, 'Share of product type': format(datum.SourceShare, '.1%'), 'Share of price band': format(datum.TargetShare, '.1%')}"
          }
        },

        "hover": {
          "strokeOpacity": {
            "value": 0.9
          }
        }
      }
    },

    {
      "type": "path",

      "from": {
        "data": "links23"
      },

      "encode": {
        "enter": {
          "path": {
            "field": "Path"
          },

          "fill": {
            "value": null
          },

          "stroke": {
            "scale": "statusColor",
            "field": "ExclusiveStatus"
          },

          "strokeWidth": {
            "field": "LinkWidth"
          },

          "strokeOpacity": {
            "value": 0.43
          },

          "strokeCap": {
            "value": "butt"
          },

          "tooltip": {
            "signal": "{'Price band': datum.PriceBand, 'Price range': '$' + format(datum.MinPrice, '.2f') + ' – $' + format(datum.MaxPrice, '.2f'), 'Exclusive status': datum.ExclusiveStatus, 'Products': datum.FlowCount, 'Share of price band': format(datum.SourceShare, '.1%'), 'Share of status': format(datum.TargetShare, '.1%')}"
          }
        },

        "hover": {
          "strokeOpacity": {
            "value": 0.9
          }
        }
      }
    },

    {
      "type": "rect",

      "from": {
        "data": "nodes1"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x1"
          },

          "x2": {
            "signal": "x1 + nodeWidth"
          },

          "y": {
            "field": "Y0"
          },

          "y2": {
            "field": "Y1"
          },

          "fill": {
            "scale": "productColor",
            "field": "ProductGroup"
          },

          "stroke": {
            "value": "white"
          },

          "strokeWidth": {
            "value": 1
          },

          "tooltip": {
            "signal": "{'Product type': datum.ProductGroup, 'Products': datum.NodeCount}"
          }
        }
      }
    },

    {
      "type": "rect",

      "from": {
        "data": "nodes2"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x2"
          },

          "x2": {
            "signal": "x2 + nodeWidth"
          },

          "y": {
            "field": "Y0"
          },

          "y2": {
            "field": "Y1"
          },

          "fill": {
            "scale": "priceColor",
            "field": "PriceBand"
          },

          "stroke": {
            "value": "white"
          },

          "strokeWidth": {
            "value": 1
          },

          "tooltip": {
            "signal": "{'Price band': datum.PriceBand, 'Price range': '$' + format(datum.MinPrice, '.2f') + ' – $' + format(datum.MaxPrice, '.2f'), 'Products': datum.NodeCount}"
          }
        }
      }
    },

    {
      "type": "rect",

      "from": {
        "data": "nodes3"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x3"
          },

          "x2": {
            "signal": "x3 + nodeWidth"
          },

          "y": {
            "field": "Y0"
          },

          "y2": {
            "field": "Y1"
          },

          "fill": {
            "scale": "statusColor",
            "field": "ExclusiveStatus"
          },

          "stroke": {
            "value": "white"
          },

          "strokeWidth": {
            "value": 1
          },

          "tooltip": {
            "signal": "{'Exclusive status': datum.ExclusiveStatus, 'Products': datum.NodeCount}"
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "nodes1"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x1 - 12"
          },

          "y": {
            "field": "NodeY"
          },

          "text": {
            "field": "ProductGroup"
          },

          "align": {
            "value": "right"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          },

          "limit": {
            "value": 155
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "nodes2"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x2 + nodeWidth + 12"
          },

          "y": {
            "field": "NodeY"
          },

          "text": {
            "field": "PriceBandLabel"
          },

          "align": {
            "value": "left"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 12
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          },

          "limit": {
            "value": 190
          }
        }
      }
    },

    {
      "type": "text",

      "from": {
        "data": "nodes3"
      },

      "encode": {
        "enter": {
          "x": {
            "signal": "x3 + nodeWidth + 12"
          },

          "y": {
            "field": "NodeY"
          },

          "text": {
            "field": "ExclusiveStatus"
          },

          "align": {
            "value": "left"
          },

          "baseline": {
            "value": "middle"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#333333"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "signal": "x1 + nodeWidth / 2"
          },

          "y": {
            "value": 32
          },

          "text": {
            "value": "PRODUCT TYPE"
          },

          "align": {
            "value": "center"
          },

          "font": {
            "value": "Arial"
          },

          "fontSize": {
            "value": 13
          },

          "fontWeight": {
            "value": "bold"
          },

          "fill": {
            "value": "#555555"
          }
        }
      }
    },

    {
      "type": "text",

      "encode": {
        "enter": {
          "x": {
            "signal": "x2 + nodeWidth / 2"
          },

          "y": {
            "value": 32
          },

          "text": {
            "value": "LISTED PRICE BAND"
          },

