{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 430,
  "title": {
    "text": "Where Is Funko Showing Up Around the World in 2026?",
    "subtitle": [
      "Official Funko convention appearances and authorised EVENT EDITION locations",
      "Each dot represents one mapped Funko event or participating location"
    ],
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Inter",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray",
        "strokeWidth": 0.8,
        "opacity": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  -180,
                  0
                ],
                [
                  -150,
                  0
                ],
                [
                  -120,
                  0
                ],
                [
                  -90,
                  0
                ],
                [
                  -60,
                  0
                ],
                [
                  -30,
                  0
                ],
                [
                  0,
                  0
                ],
                [
                  30,
                  0
                ],
                [
                  60,
                  0
                ],
                [
                  90,
                  0
                ],
                [
                  120,
                  0
                ],
                [
                  150,
                  0
                ],
                [
                  180,
                  0
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  0,
                  -90
                ],
                [
                  0,
                  -75
                ],
                [
                  0,
                  -60
                ],
                [
                  0,
                  -45
                ],
                [
                  0,
                  -30
                ],
                [
                  0,
                  -15
                ],
                [
                  0,
                  0
                ],
                [
                  0,
                  15
                ],
                [
                  0,
                  30
                ],
                [
                  0,
                  45
                ],
                [
                  0,
                  60
                ],
                [
                  0,
                  75
                ],
                [
                  0,
                  90
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_official_events_2026.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "Lon"
        },
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "Lat"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 72,
        "opacity": 0.88,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "color": {
          "field": "EventType",
          "type": "nominal",
          "title": "Event type",
          "scale": {
            "domain": [
              "Convention",
              "Store / fan event"
            ],
            "range": [
              "#4E79A7",
              "#F28E2B"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Event / location"
          },
          {
            "field": "Venue",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Dates",
            "type": "nominal",
            "title": "Dates"
          },
          {
            "field": "LocationPrecision",
            "type": "nominal",
            "title": "Location precision"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null,
      "fill": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "title": {
      "font": "Inter",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent"
}
