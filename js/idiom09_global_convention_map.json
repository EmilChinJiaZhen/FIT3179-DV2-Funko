              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_official_events_2026.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "BaseLongitude"
        },
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "BaseLatitude"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "LocalIndex"
            }
          ],
          "groupby": [
            "Country",
            "City"
          ],
          "sort": [
            {
              "field": "Event",
              "order": "ascending"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "count",
              "as": "LocalCount"
            }
          ],
          "groupby": [
            "Country",
            "City"
          ]
        },
        {
          "calculate": "ceil(sqrt(datum.LocalCount))",
          "as": "LocalWidth"
        },
        {
          "calculate": "(datum.LocalIndex - 1) % datum.LocalWidth",
          "as": "LocalCol"
        },
        {
          "calculate": "floor((datum.LocalIndex - 1) / datum.LocalWidth)",
          "as": "LocalRow"
        },
        {
          "calculate": "(datum.LocalWidth - 1) / 2",
          "as": "LocalCenterX"
        },
        {
          "calculate": "(ceil(datum.LocalCount / datum.LocalWidth) - 1) / 2",
          "as": "LocalCenterY"
        },
        {
          "calculate": "datum.BaseLongitude + (datum.LocalCol - datum.LocalCenterX) * 1.05",
          "as": "PlotLongitude"
        },
        {
          "calculate": "datum.BaseLatitude - (datum.LocalRow - datum.LocalCenterY) * 0.75",
          "as": "PlotLatitude"
        },
        {
          "calculate": "'https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/assets/funko-pop-transparent-fixed.png'",
          "as": "MarkerImage"
        }
      ],
      "mark": {
        "type": "image",
        "width": 30,
        "height": 30,
        "opacity": 1,
        "tooltip": true
      },
      "encoding": {
        "url": {
          "field": "MarkerImage",
          "type": "nominal"
        },
        "longitude": {
          "field": "PlotLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "PlotLatitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Funko presence"
          },
          {
            "field": "VerifiedType",
            "type": "nominal",
            "title": "Type"
          },
          {
            "field": "Venue",
            "type": "nominal",
            "title": "Venue / store"
          },
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Dates",
            "type": "nominal",
            "title": "Date / status"
          },
          {
            "field": "Verification",
            "type": "nominal",
            "title": "Verification"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null,
      "fill": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "title": {
      "font": "Inter",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    }
  },
  "autosize": {
    "type": "pad",
    "contains": "padding",
    "resize": false
  },
  "background": "transparent"
}
