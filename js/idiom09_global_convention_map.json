{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": 420,
  "title": {
    "text": "Where Are Funko Events and Conventions Located?",
    "subtitle": [
      "2026 mapped Funko event and convention locations",
      "Select a country · each dot represents exactly one event record"
    ],
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "subtitleFont": "Inter",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "params": [
    {
      "name": "Country_selection",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Argentina",
          "Australia",
          "Belgium",
          "Brazil",
          "Canada",
          "China",
          "Denmark",
          "Germany",
          "Greece",
          "Indonesia",
          "Italy",
          "Japan",
          "Malaysia",
          "Netherlands",
          "Singapore",
          "Spain",
          "Sweden",
          "United Arab Emirates"
        ],
        "labels": [
          "Argentina",
          "Australia",
          "Belgium",
          "Brazil",
          "Canada",
          "China",
          "Denmark",
          "Germany",
          "Greece",
          "Indonesia",
          "Italy",
          "Japan",
          "Malaysia",
          "Netherlands",
          "Singapore",
          "Spain",
          "Sweden",
          "United Arab Emirates"
        ],
        "name": "Country: "
      }
    },
    {
      "name": "map_country_name",
      "expr": "Country_selection == 'United States' ? 'United States of America' : Country_selection"
    },
    {
      "name": "jitter_step",
      "expr": "Country_selection == 'Australia' ? 0.35 : Country_selection == 'Canada' ? 0.30 : Country_selection == 'United Arab Emirates' ? 0.18 : Country_selection == 'Singapore' ? 0.006 : Country_selection == 'Belgium' || Country_selection == 'Netherlands' ? 0.04 : Country_selection == 'Denmark' ? 0.05 : Country_selection == 'Germany' || Country_selection == 'Spain' || Country_selection == 'Italy' ? 0.08 : 0.10"
    }
  ],
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_admin_0_countries.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.NAME == map_country_name"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#D3D3D3",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "properties.NAME",
            "type": "nominal",
            "title": "Country"
          }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_2026_event_locations.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.Country == Country_selection"
        },
        {
          "calculate": "toNumber(datum.Longitude)",
          "as": "BaseLongitude"
        },
        {
          "calculate": "toNumber(datum.Latitude)",
          "as": "BaseLatitude"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "CityDotIndex"
            }
          ],
          "groupby": [
            "Country",
            "City"
          ],
          "sort": [
            {
              "field": "Event",
              "order": "ascending"
            }
          ]
        },
        {
          "calculate": "datum.BaseLongitude + ((datum.CityDotIndex - 1) % 3 - 1) * jitter_step",
          "as": "PlotLongitude"
        },
        {
          "calculate": "datum.BaseLatitude + floor((datum.CityDotIndex - 1) / 3) * jitter_step",
          "as": "PlotLatitude"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 95,
        "color": "#7D57C2",
        "opacity": 0.86,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "PlotLongitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "PlotLatitude",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Event",
            "type": "nominal",
            "title": "Event / convention"
          },
          {
            "field": "Venue",
            "type": "nominal",
            "title": "Venue"
          },
          {
            "field": "City",
            "type": "nominal",
            "title": "City"
          },
          {
            "field": "Country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Dates",
            "type": "nominal",
            "title": "Dates"
          }
        ]
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null,
      "fill": null
    },
    "title": {
      "font": "Inter",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    },
    "legend": {
      "titleFont": "Inter",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent"
}
