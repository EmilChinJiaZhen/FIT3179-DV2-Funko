                ],
                [
                  180,
                  0
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  0,
                  -90
                ],
                [
                  0,
