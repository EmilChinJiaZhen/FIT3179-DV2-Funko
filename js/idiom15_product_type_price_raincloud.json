{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 800,
  "height": 590,
  "padding": {
    "top": 15,
    "left": 15,
    "right": 20,
    "bottom": 45
  },
  "autosize": {
    "type": "pad",
    "resize": true
  },
  "title": {
    "text": "How Do Funko Prices Vary Across Product Types?",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "signals": [
    {
      "name": "plotLeft",
      "value": 105
    },
    {
      "name": "plotRight",
      "update": "width - 12"
    },
    {
      "name": "firstRowY",
      "value": 62
    },
    {
      "name": "rowGap",
      "value": 91
    },
    {
      "name": "cloudHeight",
      "value": 35
    },
    {
      "name": "priceFilterMin",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 200,
        "step": 5,
        "name": "Min price ($): "
      }
    },
    {
      "name": "priceFilterMax",
      "value": 500,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 500,
        "step": 5,
        "name": "Max price ($): "
      }
    },
    {
      "name": "linkedPriceType",
      "value": ""
    }
  ],
  "data": [
    {
      "name": "base",
      "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.uid) && isValid(datum.product_type) && datum.product_type != '' && isValid(datum.price) && datum.price != '' && isValid(datum.published_at)"
        },
        {
          "type": "formula",
          "expr": "toDate(datum.published_at)",
          "as": "ReleaseDate"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.ReleaseDate)"
        },
        {
          "type": "formula",
          "expr": "year(datum.ReleaseDate)",
          "as": "ReleaseYear"
        },
        {
          "type": "filter",
          "expr": "datum.ReleaseYear >= 2019 && datum.ReleaseYear <= 2022"
        },
        {
          "type": "formula",
          "expr": "toNumber(datum.price)",
          "as": "PriceValue"
        },
        {
          "type": "filter",
          "expr": "isValid(datum.PriceValue) && datum.PriceValue > 0"
        },
        {
          "type": "formula",
          "expr": "trim(toString(datum.product_type))",
          "as": "ProductType"
        },
        {
          "type": "formula",
          "expr": "indexof(lower(toString(datum.tags)), 'exclusive') >= 0 ? 'Exclusive-tagged' : 'No exclusive tag'",
          "as": "ExclusiveStatus"
        },
        {
          "type": "filter",
          "expr": "datum.PriceValue >= priceFilterMin && (priceFilterMax === 500 || datum.PriceValue <= priceFilterMax)"
        }
      ]
    },
    {
      "name": "product_totals",
      "source": "base",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ProductType"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            "uid"
          ],
          "as": [
            "ProductTypeCount"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "ProductTypeCount",
              "ProductType"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "ProductTypeRank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.ProductTypeRank <= 6"
        }
      ]
    },
    {
      "name": "selected",
      "source": "base",
      "transform": [
        {
          "type": "lookup",
          "from": "product_totals",
          "key": "ProductType",
          "fields": [
            "ProductType"
          ],
          "values": [
            "ProductTypeRank",
            "ProductTypeCount"
          ],
          "as": [
            "ProductTypeRank",
            "ProductTypeCount"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.ProductTypeRank)"
        },
        {
          "type": "window",
          "groupby": [
            "ProductType"
          ],
          "sort": {
            "field": [
              "PriceValue",
              "uid"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "PointOrder"
          ]
        },
        {
          "type": "formula",
          "expr": "firstRowY + (datum.ProductTypeRank - 1) * rowGap",
          "as": "BaseY"
        },
        {
          "type": "formula",
          "expr": "datum.BaseY + 15 + ((datum.PointOrder - 1) % 5) * 5",
          "as": "PointY"
        }
      ]
    },
    {
      "name": "stats",
      "source": "selected",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "ProductType",
            "ProductTypeRank",
            "ProductTypeCount"
          ],
          "ops": [
            "min",
            "q1",
            "median",
            "mean",
            "q3",
            "max",
            "count"
          ],
          "fields": [
            "PriceValue",
            "PriceValue",
            "PriceValue",
            "PriceValue",
            "PriceValue",
            "PriceValue",
            "uid"
          ],
          "as": [
            "MinPrice",
            "Q1",
            "MedianPrice",
            "MeanPrice",
            "Q3",
            "MaxPrice",
            "ProductCount"
          ]
        },
        {
          "type": "formula",
          "expr": "firstRowY + (datum.ProductTypeRank - 1) * rowGap",
          "as": "BaseY"
        }
      ]
    },
    {
      "name": "density",
      "source": "selected",
      "transform": [
        {
          "type": "kde",
          "field": "PriceValue",
          "groupby": [
            "ProductType",
            "ProductTypeRank"
          ],
          "steps": 120,
          "as": [
            "DensityPrice",
            "Density"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "ProductType"
          ],
          "ops": [
            "max"
          ],
          "fields": [
            "Density"
          ],
          "as": [
            "MaxDensity"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.MaxDensity > 0 ? datum.Density / datum.MaxDensity : 0",
          "as": "NormalisedDensity"
        },
        {
          "type": "formula",
          "expr": "firstRowY + (datum.ProductTypeRank - 1) * rowGap",
          "as": "BaseY"
        },
        {
          "type": "formula",
          "expr": "datum.BaseY - datum.NormalisedDensity * cloudHeight",
          "as": "CloudY"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "xscale",
      "type": "linear",
      "domain": {
        "data": "selected",
        "field": "PriceValue"
      },
      "range": [
        {
          "signal": "plotLeft"
        },
        {
          "signal": "plotRight"
        }
      ],
      "zero": true,
      "nice": true
    },
    {
      "name": "productColor",
      "type": "ordinal",
      "domain": [
        "Pop!",
        "Apparel",
        "Keychains",
        "Vinyl GOLD",
        "Plush",
        "Board Games",
        "Other product types"
      ],
      "range": [
        "#4E79A7",
        "#76B7B2",
        "#F28E2B",
        "#EDC948",
        "#B07AA1",
        "#7F7F7F",
        "#D6CFC2"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "xscale",
      "title": "Listed price (USD)",
      "format": "$,.0f",
      "grid": true,
      "gridColor": "#E4E4E4",
      "gridOpacity": 0.7,
      "domainColor": "#999999",
      "tickColor": "#999999",
      "labelFont": "Inter",
      "labelFontSize": 16,
      "labelPadding": 6,
      "titleFont": "Inter",
      "titleFontSize": 18,
      "titleFontWeight": "normal",
      "titlePadding": 12
    }
  ],
  "marks": [
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "densityFacet",
          "data": "density",
          "groupby": [
            "ProductType"
          ]
        }
      },
      "marks": [
        {
          "type": "area",
          "from": {
            "data": "densityFacet"
          },
          "sort": {
            "field": "DensityPrice"
          },
          "encode": {
            "enter": {
              "x": {
                "scale": "xscale",
                "field": "DensityPrice"
              },
              "y": {
                "field": "CloudY"
              },
              "y2": {
                "field": "BaseY"
              },
              "fill": {
                "scale": "productColor",
                "field": "ProductType"
              },
              "fillOpacity": {
                "value": 0.48
              },
              "stroke": {
                "scale": "productColor",
                "field": "ProductType"
              },
              "strokeWidth": {
                "value": 1.5
              },
              "interpolate": {
                "value": "monotone"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "from": {
        "data": "stats"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xscale",
            "field": "MinPrice"
          },
          "x2": {
            "scale": "xscale",
            "field": "MaxPrice"
          },
          "y": {
            "field": "BaseY"
          },
          "stroke": {
            "value": "#555555"
          },
          "strokeWidth": {
            "value": 1.4
          }
        },
        "update": {
          "opacity": {
            "signal": "linkedPriceType === '' || datum.ProductType === linkedPriceType ? 1 : 0.17"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "stats"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xscale",
            "field": "Q1"
          },
          "x2": {
            "scale": "xscale",
            "field": "Q3"
          },
          "y": {
            "signal": "datum.BaseY - 5"
          },
          "y2": {
            "signal": "datum.BaseY + 5"
          },
          "fill": {
            "scale": "productColor",
            "field": "ProductType"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 1.2
          },
          "cornerRadius": {
            "value": 2
          }
        },
        "update": {
          "opacity": {
            "signal": "linkedPriceType === '' || datum.ProductType === linkedPriceType ? 1 : 0.17"
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "stats"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xscale",
            "field": "MedianPrice"
          },
          "y": {
            "signal": "datum.BaseY - 7"
          },
          "y2": {
            "signal": "datum.BaseY + 7"
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 2.5
          }
        },
        "update": {
          "opacity": {
            "signal": "linkedPriceType === '' || datum.ProductType === linkedPriceType ? 1 : 0.17"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "selected"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "xscale",
            "field": "PriceValue"
          },
          "y": {
            "field": "PointY"
          },
          "size": {
            "value": 28
          },
          "shape": {
            "value": "circle"
          },
          "fill": {
            "scale": "productColor",
            "field": "ProductType"
          },
          "fillOpacity": {
            "value": 0.48
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 0.4
          }
        },
        "hover": {
          "size": {
            "value": 85
          },
          "fillOpacity": {
            "value": 1
          },
          "stroke": {
            "value": "#222222"
          },
          "strokeWidth": {
            "value": 1
          }
        },
        "update": {
          "size": {
            "value": 28
          },
          "fillOpacity": {
            "value": 0.48
          },
          "stroke": {
            "value": "white"
          },
          "strokeWidth": {
            "value": 0.4
          },
          "opacity": {
            "signal": "linkedPriceType === '' || datum.ProductType === linkedPriceType ? 1 : 0.17"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "stats"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "plotLeft - 14"
          },
          "y": {
            "field": "BaseY"
          },
          "text": {
            "field": "ProductType"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "Inter"
          },
          "fontSize": {
            "value": 18
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#333333"
          }
        },
        "update": {
          "opacity": {
            "signal": "linkedPriceType === '' || datum.ProductType === linkedPriceType ? 1 : 0.17"
          }
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 16,
      "titleFontSize": 18,
      "titleFontWeight": 600
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter",
      "fontSize": 20,
      "fontWeight": "bold",
      "subtitleFontSize": 13,
      "subtitleFontWeight": "normal"
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "view": {
      "fill": null,
      "stroke": null
    }
  },
  "background": "transparent"
}
