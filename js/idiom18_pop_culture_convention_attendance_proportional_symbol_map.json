{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 720,
  "height": 430,
  "title": {
    "text": "Where Do Verified Funko Licenses in the Dataset Originate?",
    "subtitle": [
      "All 380 unique license strings from data_cleaned_wide.csv are retained in the lookup",
      "Circle area represents product records for licenses with a verified origin mapping"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "fontWeight": "bold",
    "subtitleFont": "Arial",
    "subtitleFontSize": 13,
    "subtitleFontWeight": "normal",
    "subtitlePadding": 8
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ECECEC",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "license",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_franchise_origin_lookup_all_licenses.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "License",
            "fields": [
              "Franchise",
              "Country",
              "Region",
              "Latitude",
              "Longitude",
              "CountryWikidata",
              "CoordinateSource",
              "FranchiseOriginSource"
            ]
          }
        },
        {
          "filter": "isValid(datum.Latitude) && isValid(datum.Longitude)"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "ProductCount"
            },
            {
              "op": "distinct",
              "field": "license",
              "as": "LicenseCount"
            }
          ],
          "groupby": [
            "Country",
            "Region",
            "Latitude",
            "Longitude",
            "CountryWikidata",
            "CoordinateSource"
          ]
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "CountryRank"
            }
          ],
          "sort": [
            {
              "field": "ProductCount",
              "order": "descending"
            }
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "ProductCount",
          "type": "quantitative",
          "title": "Funko product records",
          "scale": {
            "type": "sqrt",
            "range": [
              100,
              3200
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFont": "Arial",
            "titleFontSize": 12,
            "labelFont": "Arial",
            "labelFontSize": 11
          }
        },
        "color": {
          "field": "Region",
          "type": "nominal",
          "title": "Origin region",
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFont": "Arial",
            "titleFontSize": 12,
            "labelFont": "Arial",
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "Country",
            "type": "nominal",
            "title": "Origin country"
          },
          {
            "field": "ProductCount",
            "type": "quantitative",
            "title": "Product records",
            "format": ","
          },
          {
            "field": "LicenseCount",
            "type": "quantitative",
            "title": "Unique mapped licenses"
          },
          {
            "field": "CountryRank",
            "type": "quantitative",
            "title": "Rank"
          },
        ]
      }
    }
  ],
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  }
}
