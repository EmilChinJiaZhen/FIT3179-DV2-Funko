{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 750,
  "height": 354,
  "title": {
    "text": "Where Do Verified Funko Licenses in the Dataset Originate?",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold",
    "offset": 16
  },
  "projection": {
    "type": "equalEarth",
    "scale": {
      "expr": "origin_zoom"
    },
    "center": {
      "expr": "origin_pan_center"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "skyblue"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "lightgray",
        "strokeWidth": 0.8,
        "opacity": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  -180,
                  0
                ],
                [
                  -150,
                  0
                ],
                [
                  -120,
                  0
                ],
                [
                  -90,
                  0
                ],
                [
                  -60,
                  0
                ],
                [
                  -30,
                  0
                ],
                [
                  0,
                  0
                ],
                [
                  30,
                  0
                ],
                [
                  60,
                  0
                ],
                [
                  90,
                  0
                ],
                [
                  120,
                  0
                ],
                [
                  150,
                  0
                ],
                [
                  180,
                  0
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15,
        "opacity": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "type": "Feature",
            "geometry": {
              "type": "LineString",
              "coordinates": [
                [
                  0,
                  -90
                ],
                [
                  0,
                  -75
                ],
                [
                  0,
                  -60
                ],
                [
                  0,
                  -45
                ],
                [
                  0,
                  -30
                ],
                [
                  0,
                  -15
                ],
                [
                  0,
                  0
                ],
                [
                  0,
                  15
                ],
                [
                  0,
                  30
                ],
                [
                  0,
                  45
                ],
                [
                  0,
                  60
                ],
                [
                  0,
                  75
                ],
                [
                  0,
                  90
                ]
              ]
            }
          }
        ]
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#8C8C8C",
        "strokeWidth": 1.15,
        "opacity": 1
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "lookup": "license",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/funko_franchise_origin_lookup_all_licenses.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "License",
            "fields": [
              "Franchise",
              "Country",
              "Region",
              "Latitude",
              "Longitude",
              "CountryWikidata",
              "CoordinateSource",
              "FranchiseOriginSource",
              "VerificationStatus",
              "OriginConfidence",
              "OriginBasis"
            ]
          }
        },
        {
          "filter": "datum.VerificationStatus == 'Verified' && isValid(datum.Latitude) && isValid(datum.Longitude)"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "ProductCount"
            },
            {
              "op": "distinct",
              "field": "license",
              "as": "LicenseCount"
            }
          ],
          "groupby": [
            "Country",
            "Region",
            "Latitude",
            "Longitude",
            "CountryWikidata",
            "CoordinateSource"
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "ProductCount",
              "as": "MaxProductCount"
            }
          ]
        },
        {
          "calculate": "10 + 66 * sqrt(datum.ProductCount / datum.MaxProductCount)",
          "as": "TriangleHeight"
        },
        {
          "calculate": "80 - datum.TriangleHeight",
          "as": "TriangleApexY"
        },
        {
          "calculate": "datum.Region == 'North America' ? '#5C4FA3' : datum.Region == 'Europe' ? '#C05792' : '#1F8C83'",
          "as": "TriangleColor"
        },
        {
          "calculate": "'data:image/svg+xml;utf8,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%2016%2080%22%3E%3Cpolygon%20points=%228,' + datum.TriangleApexY + '%201,80%2015,80%22%20fill=%22' + replace(datum.TriangleColor, '#', '%23') + '%22%20stroke=%22white%22%20stroke-width=%221%22/%3E%3C/svg%3E'",
          "as": "TriangleImage"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "CountryRank"
            }
          ],
          "sort": [
            {
              "field": "ProductCount",
              "order": "descending"
            }
          ]
        }
      ],
      "mark": {
        "type": "image",
        "width": 18,
        "height": 82,
        "align": "center",
        "baseline": "bottom",
        "opacity": 0.9
      },
      "encoding": {
        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },
        "url": {
          "field": "TriangleImage",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null,
      "fill": null
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "orient": "right",
      "direction": "vertical",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "title": {
      "font": "Inter",
      "fontWeight": "bold",
      "subtitleFont": "Inter",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 600
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    }
  },
  "autosize": {
    "type": "pad",
    "contains": "padding",
    "resize": false
  },
  "background": "transparent",
  "params": [
    {
      "name": "origin_zoom",
      "value": 130,
      "bind": {
        "input": "range",
        "min": 100,
        "max": 450,
        "step": 10,
        "name": "Zoom: "
      }
    },
    {
      "name": "origin_center",
      "value": [
        0,
        0
      ],
      "bind": {
        "input": "select",
        "name": "Map region: ",
        "options": [
          [
            0,
            0
          ],
          [
            -95,
            15
          ],
          [
            15,
            48
          ],
          [
            105,
            5
          ]
        ],
        "labels": [
          "World",
          "Americas",
          "Europe",
          "Asia-Pacific"
        ]
      }
    },
    {
      "name": "origin_pan_center",
      "value": [
        0,
        0
      ]
    }
  ]
}
