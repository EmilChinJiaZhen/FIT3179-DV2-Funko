{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Funko Products by License",
    "anchor": "start",
    "fontSize": 20,
    "font": "Inter",
    "fontWeight": "bold",
    "offset": 16
  },
  "width": "container",
  "height": 600,
  "data": {
    "url": "https://raw.githubusercontent.com/EmilChinJiaZhen/FIT3179-DV2-Funko/refs/heads/main/data/data_cleaned_wide.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.license) && datum.license != ''"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "Product_Count"
        }
      ],
      "groupby": [
        "license"
      ]
    },
    {
      "window": [
        {
          "op": "rank",
          "as": "Rank"
        }
      ],
      "sort": [
        {
          "field": "Product_Count",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.Rank <= 10"
    }
  ],
  "encoding": {
    "x": {
      "field": "Product_Count",
      "type": "quantitative",
      "title": "Number of Funko products",
      "axis": {
        "grid": true,
        "tickMinStep": 1,
        "tickCount": 5
      }
    },
    "y": {
      "field": "license",
      "type": "nominal",
      "sort": {
        "field": "Product_Count",
        "order": "descending"
      },
      "title": "License",
      "axis": {
        "labelLimit": 260,
        "labelOverlap": false,
        "titlePadding": 12,
        "labelExpr": "indexof(datum.label, 'Nightmare') >= 0 ? ['The Nightmare','Before Christmas'] : indexof(datum.label, 'Five Nights') >= 0 ? ['Five Nights at',\"Freddy's\"] : datum.label === 'My Hero Academia' ? ['My Hero','Academia'] : datum.label"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Rank <= 3",
            "value": "#4E79A7"
          },
          "value": "#C9D3E1"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 130
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.Rank <= 3",
            "value": "#4E79A7"
          },
          "value": "#C9D3E1"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dy": 0,
        "fontSize": 11,
        "font": "Inter",
        "dx": 8
      },
      "encoding": {
        "text": {
          "field": "Product_Count",
          "type": "quantitative"
        },
        "color": {
          "value": "#35445e"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null,
      "fill": null
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleFontWeight": 400,
      "labelFontWeight": 400
    },
    "title": {
      "font": "Inter",
      "subtitleFont": "Inter",
      "fontWeight": "bold",
      "subtitleFontWeight": "normal",
      "fontSize": 20,
      "subtitleFontSize": 13
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelFontWeight": 400
    },
    "header": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": 700
    },
    "background": "transparent"
  },
  "background": "transparent",
  "autosize": {
    "type": "pad",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 8,
    "left": 18,
    "right": 18,
    "bottom": 10
  }
}
