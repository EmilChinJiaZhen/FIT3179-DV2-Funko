{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 560,
  "height": 310,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": null,
  "title": {
    "text": "Where Have Funko-Branded Products Been Traded?",
    "anchor": "start",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": "bold"
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      0,
      0,
      0
    ],
    "scale": 94
  },
  "params": [],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#89CDE8",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/WorldMapWithGraticules.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#C8D7E0",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/2_symbol_map/js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D7D7D7",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.65
      }
    },
    {
      "data": {
        "values": [
          {
            "route_id": "R1",
            "year": 2024,
            "role": "Exporting country",
            "country": "Malaysia",
            "longitude": 102,
            "latitude": 4
          },
          {
            "route_id": "R1",
            "year": 2024,
            "role": "Importing country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R2",
            "year": 2024,
            "role": "Exporting country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R2",
            "year": 2024,
            "role": "Importing country",
            "country": "Costa Rica",
            "longitude": -84,
            "latitude": 10
          },
          {
            "route_id": "R3",
            "year": 2025,
            "role": "Exporting country",
            "country": "Vietnam",
            "longitude": 108,
            "latitude": 16
          },
          {
            "route_id": "R3",
            "year": 2025,
            "role": "Importing country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R4",
            "year": 2025,
            "role": "Exporting country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R4",
            "year": 2025,
            "role": "Importing country",
            "country": "Malaysia",
            "longitude": 102,
            "latitude": 4
          },
          {
            "route_id": "R5",
            "year": 2025,
            "role": "Exporting country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R5",
            "year": 2025,
            "role": "Importing country",
            "country": "Bolivia",
            "longitude": -64,
            "latitude": -17
          },
          {
            "route_id": "R6",
            "year": 2025,
            "role": "Exporting country",
            "country": "United States",
            "longitude": -98,
            "latitude": 39
          },
          {
            "route_id": "R6",
            "year": 2025,
            "role": "Importing country",
            "country": "Costa Rica",
            "longitude": -84,
            "latitude": 10
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.role === 'Exporting country' ? 1 : 0",
          "as": "export_record"
        },
        {
          "calculate": "datum.role === 'Importing country' ? 1 : 0",
          "as": "import_record"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "export_record",
              "as": "export_count"
            },
            {
              "op": "sum",
              "field": "import_record",
              "as": "import_count"
            }
          ],
          "groupby": [
            "country",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum.export_count > 0 && datum.import_count > 0 ? 'Import and export' : datum.export_count > 0 ? 'Export only' : 'Import only'",
          "as": "trade_role"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 115,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.6,
        "opacity": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "trade_role",
          "type": "nominal",
          "scale": {
            "domain": [
              "Import and export",
              "Export only",
              "Import only"
            ],
            "range": [
              "#274E79",
              "#138C83",
              "#C98B34"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "trade_role",
            "type": "nominal",
            "title": "Role in selected records"
          },
          {
            "field": "export_count",
            "type": "quantitative",
            "title": "Exporting records"
          },
          {
            "field": "import_count",
            "type": "quantitative",
            "title": "Importing records"
          }
        ]
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter"
    },
    "axis": {
      "labelFont": "Inter"
    }
  },
  "description": "Selected trade-record routes with one marker per country. Country roles are aggregated across six records; exporting/importing counts are sample record counts, not total Funko trade volumes. Curved schematic SVG routes show recorded direction."
}
