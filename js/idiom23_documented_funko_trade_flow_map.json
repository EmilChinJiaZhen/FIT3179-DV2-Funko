      "transform": [
        {
          "calculate": "datum.role === 'Exporting country' ? 1 : 0",
          "as": "export_record"
        },
        {
          "calculate": "datum.role === 'Importing country' ? 1 : 0",
          "as": "import_record"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "export_record",
              "as": "export_count"
            },
            {
              "op": "sum",
              "field": "import_record",
              "as": "import_count"
            }
          ],
          "groupby": [
            "country",
            "longitude",
            "latitude"
          ]
        },
        {
          "calculate": "datum.export_count > 0 && datum.import_count > 0 ? 'Import and export' : datum.export_count > 0 ? 'Export only' : 'Import only'",
          "as": "trade_role"
        },
        {
          "calculate": "indexof(['China','Vietnam','Malaysia','Philippines','Kazakhstan'],datum.country) >= 0 ? 'Asia' : datum.country === 'United Kingdom' ? 'Europe' : 'Americas'",
          "as": "trade_region"
        }
      ],
